# Wrishu Photography Environment Variables Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env or secrets to public source control.

# --- Supabase Public Client Credentials ---
# Found in Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Cloudflare R2 & Worker ---
# Custom CDN domain pointing to your R2 public bucket for fast image delivery
VITE_CLOUDFLARE_R2_CDN="https://cdn.wrishu.com"

# Cloudflare Worker URL that issues presigned R2 upload URLs after verifying JWT + admin role
VITE_WORKER_UPLOAD_URL="https://upload-signer.wrishu.workers.dev"

# --- Optional Cloudflare Turnstile CAPTCHA ---
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# --- AI Studio Runtime Defaults ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
